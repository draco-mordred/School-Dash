# ─── Database ───────────────────────────────────────────────────────────
MEDLOG_MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/medlog
# (MONGODB_URI / MONGO_URI are accepted as alternate names)

# ─── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-long-random-string
# Recommended separate secret for QR payload signing:
QR_SIGNING_SECRET=replace-with-another-long-random-string

# ─── Frontend origin (CORS) ──────────────────────────────────────────────
CLIENT_URL=https://your-frontend.vercel.app
NODE_ENV=development

# ─── AI key pool (DALE + DM moderation) ──────────────────────────────────
# At least one key required for AI replies; without one, DM moderation runs
# deterministic-only. Pairs are tried in order and rotated on failure.
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY_2=
# Optional model overrides:
MORDRED_MISTRAL_MODEL=
MORDRED_MODEL=

# ─── Inngest Cloud (production scheduling) ───────────────────────────────
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
USE_INNGEST_SCHEDULING=true
# Local dev only:
INNGEST_DEVSERVER_URL=http://localhost:8288

# ─── Optional integrations ──────────────────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
EXPRESS_BODY_LIMIT=10mb
PORT=5000
